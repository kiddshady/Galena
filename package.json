{
  "name": "galena",
  "productName": "Galena",
  "version": "0.1.0",
  "description": "Galena — simulador de laboratorio de Tecnología Farmacéutica II (TPL 1 a 4).",
  "main": "main.cjs",
  "author": "Kidd Shady · Umbrovex Systems <umbrovex@proton.me>",
  "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/datos.test.mjs",
    "smoke": "electron test/renderer.test.cjs",
    "partidas": "electron test/partidas.test.cjs",
    "icons": "node tools/icons.mjs",
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.umbrovex.galena",
    "productName": "Galena",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "directories": { "output": "dist" },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!data/**",
      "!test/**",
      "!docs/**",
      "!tools/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    }
  }
}