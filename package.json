{
  "name": "galena",
  "productName": "Galena",
  "version": "0.1.3",
  "description": "Galena — simulador de laboratorio de Tecnología Farmacéutica II (TPL 1 a 4).",
  "main": "main.cjs",
  "author": "Kidd Shady · Umbrovex Systems <umbrovex@proton.me>",
  "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs && node test/datos.test.mjs && node test/actualizador.test.mjs",
    "partidas": "electron test/partidas.test.cjs",
    "icons": "node tools/icons.mjs",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://github.com/kiddshady/Galena",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiddshady/Galena.git"
  },
  "build": {
    "appId": "com.umbrovex.galena",
    "productName": "Galena",
    "copyright": "Copyright © 2026 Kidd Shady · Umbrovex Systems",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "Galena",
      "releaseType": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!data/**",
      "!test/**",
      "!docs/**",
      "!tools/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
